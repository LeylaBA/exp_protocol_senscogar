  <Flow>
    <Routine name="welcome"/>
    <Routine name="exp_details"/>
    <Routine name="practice_info"/>
    <LoopInitiator loopType="TrialHandler" name="practice_trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (81).png', 'msg': 'Sometimes the puzzle can look like just one of the pieces you have...', 'msg_pos': (0, 0.3)}, {'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (80).png', 'msg': '...but it is composed by all the 7 pieces you have.', 'msg_pos': (0, -0.3)}, {'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (79).png', 'msg': 'Sometimes the puzzle can look like it is not a complete shape...', 'msg_pos': (0, 0.3)}, {'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (78).png', 'msg': &quot;...but rather a random arrangement of all the 7 pieces and that's ok!&quot;, 'msg_pos': (0, -0.3)}, {'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (86).png', 'msg': 'And sometimes the puzzle can also look like a complete shape...', 'msg_pos': (0, 0.3)}, {'stims': 'DFKI\\experiment_design\\stimuli\\practice\\tangram (85).png', 'msg': &quot;...that has been created by using all 7 pieces and that's ok too!&quot;, 'msg_pos': (0, -0.3)}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="DFKI/experiment_design/conditions/practice.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="practice_trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="practice"/>
    <LoopTerminator name="practice_trials"/>
    <LoopInitiator loopType="TrialHandler" name="block">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'conds': 'DFKI\\experiment_design\\conditions\\LowclBlock.xlsx', 'readymsg': 'some easy puzzles'}, {'conds': 'DFKI\\experiment_design\\conditions\\HighclBlock.xlsx', 'readymsg': 'some hard puzzles'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$&quot;DFKI\experiment_design\conditions\ChooseBlocks&quot;+expInfo['group']+&quot;.xlsx&quot;" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="block" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="session_info"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$conds" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
    <LoopTerminator name="block"/>
    <Routine name="bye"/>
  </Flow>
</PsychoPy2experiment>
